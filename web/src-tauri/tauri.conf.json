{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AlphaLoop",
  "version": "0.1.0",
  "identifier": "com.alphaloop.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AlphaLoop",
        "width": 1440,
        "height": 900,
        "minWidth": 1200,
        "minHeight": 760,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 14 }
      }
    ],
    "security": {
      "csp": "default-src 'self' http://localhost:8000; connect-src 'self' http://localhost:8000; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [],
    "macOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
