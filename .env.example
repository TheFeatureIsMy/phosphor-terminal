VITE_USE_MOCK=true
VITE_API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://pulsedesk:pulsedesk@localhost:5432/pulsedesk
# Optional roles for RLS (see docs/operations/multi-tenant-upgrade.md).
# APP_DB_PASSWORD=pulsedesk_app
# WORKER_DB_PASSWORD=pulsedesk_worker
# DATABASE_URL=postgresql://alphaloop_app:pulsedesk_app@localhost:5432/pulsedesk
# DATABASE_URL_WORKER=postgresql://alphaloop_worker:pulsedesk_worker@localhost:5432/pulsedesk
# Max providers tested per tenant per health tick (0 = unlimited).
# PROVIDER_HEALTH_PER_TENANT_LIMIT=0
# Tenant runtime health sweep (0 = disabled).
# TENANT_RUNTIME_HEALTH_INTERVAL_S=0
# SESSION_CLEANUP_INTERVAL_HOURS=0
# Public URL used in invite emails.
# PUBLIC_BASE_URL=https://app.example.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_TLS=true
# TENANT_RUNTIME_PROVISIONING_ENABLED=false
# TENANT_RUNTIME_PROVIDER=docker   # or kubernetes
# TENANT_RUNTIME_NAMESPACE=alphaloop
# TENANT_RUNTIME_PVC=alphaloop-tenant-data
# TENANT_RUNTIME_KUBECTL_BIN=kubectl
# TENANT_RUNTIME_DOCKER_BIN=docker
# TENANT_RUNTIME_IMAGE=freqtradeorg/freqtrade:stable
# TENANT_RUNTIME_NETWORK=phosphor-terminal_default
FREQTRADE_URL=http://localhost:8080
FREQTRADE_DB_PATH=../freqtrade/user_data/tradesv3.sqlite
LOG_LEVEL=INFO
LOG_FORMAT=json

# Gate for POST /api/trading/start-live-small — keep false until dry-run validation completes
LIVE_SMALL_ENABLED=false
