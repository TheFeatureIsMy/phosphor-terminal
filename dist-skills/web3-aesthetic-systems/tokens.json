{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "meta": {
    "name": "web3-aesthetic-systems",
    "version": "1.0.0",
    "description": "Machine-readable token sets for six Web3/crypto/fintech aesthetic systems. Pair with SKILL.md for layout DNA, signature, motion, and intent. Copy hex/fonts verbatim; do not average systems together.",
    "note": "PROTOCOL is the only light-mode system. SPATIAL's signature is structural (node graph + edge-flow), not token-level — see SKILL.md §5 and §8."
  },
  "tokenContract": [
    "bg", "panel", "panel2", "border", "borderWidth", "hairline",
    "text", "textDim", "textMute",
    "accent", "accentOn", "up", "down", "warn",
    "radius", "radiusLg", "shadow",
    "fontDisplay", "fontBody", "fontMono",
    "density", "letterSpacing", "uppercase"
  ],
  "systems": {
    "ledger": {
      "label": "① LEDGER · On-chain Ledger",
      "lineage": "Etherscan / block explorers",
      "mode": "dark",
      "bestFor": ["records", "logs", "transaction lists", "signal streams"],
      "layoutDNA": "Single vertical ledger stream, no cards. Fixed left gutter (index + timestamp), 1px hairline between rows. Each entry is a signed block.",
      "signature": "Entries as signed blocks: truncated hash 0x8f..2a + verification check + thin confirmation-progress bar.",
      "tokens": {
        "bg": "#0D0F0E", "panel": "#111413", "panel2": "#141917",
        "border": "#1E2422", "borderWidth": "1px", "hairline": "#1E2422",
        "text": "#C8D0CC", "textDim": "#6B7671", "textMute": "#4A5551",
        "num": "#E8EEEB",
        "accent": "#2FBF71", "accentOn": "#04120B",
        "up": "#2FBF71", "down": "#D9544D", "warn": "#C9A227",
        "radius": "4px", "radiusLg": "4px", "shadow": "none",
        "fontDisplay": "IBM Plex Mono", "fontBody": "IBM Plex Mono", "fontMono": "IBM Plex Mono",
        "density": "15px", "letterSpacing": "0.03em", "uppercase": false
      },
      "icons": ["✓", "▸", "⬢", "░", "█", "──", "│"],
      "forbidden": ["cards", "backdrop-filter", "mesh/aurora", "gradient-text", "radius>4px", "purple/blue-violet", "emoji", "gradients"]
    },
    "depth": {
      "label": "② DEPTH · Depth Cockpit",
      "lineage": "Bloomberg Terminal / dYdX",
      "mode": "dark",
      "bestFor": ["trading terminals", "dense data", "order books"],
      "layoutDNA": "High-density multi-pane cockpit. 24px top ticker-tape marquee. Tight CSS grid, 1px dividers, tiny labels. Hero = live order-book depth ladder if available.",
      "signature": "Order-book depth ladder: price levels with right-to-left cumulative-volume bars (bids green, asks red), amber mark price + spread.",
      "tokens": {
        "bg": "#080807", "panel": "#0E0D0B", "panel2": "#131109",
        "border": "#211F1A", "borderWidth": "1px", "hairline": "#211F1A",
        "text": "#D6CBB0", "textDim": "#7A7159", "textMute": "#565043",
        "accent": "#F5A623", "accentOn": "#080807",
        "up": "#3FB950", "down": "#E5484D", "warn": "#F5A623",
        "radius": "2px", "radiusLg": "3px", "shadow": "none",
        "fontDisplay": "JetBrains Mono", "fontBody": "JetBrains Mono", "fontMono": "JetBrains Mono",
        "density": "14px", "letterSpacing": "0.08em", "uppercase": true
      },
      "icons": ["▲", "▼", "●", "░", "█", "│", "═"],
      "forbidden": ["radius>2px", "glass", "mesh", "gradient-text", "purple/blue", "emoji", "generous whitespace", "neon cyan"]
    },
    "protocol": {
      "label": "③ PROTOCOL · Institutional DeFi",
      "lineage": "Uniswap / Base / Phantom",
      "mode": "light",
      "bestFor": ["consumer DeFi", "onboarding", "portfolios"],
      "layoutDNA": "Light, generous whitespace, large radius (16-20px), rhythmic bento (not three equal cards). Light borders + soft tinted shadow.",
      "signature": "Clean primary asset card: large tabular number + embedded smooth cobalt area curve + status pill.",
      "tokens": {
        "bg": "#F6F7FB", "panel": "#FFFFFF", "panel2": "#FFFFFF",
        "border": "#E6E9F2", "borderWidth": "1px", "hairline": "#EEF0F6",
        "text": "#0F1524", "textDim": "#5A6480", "textMute": "#8A93A8",
        "accent": "#3D5AFE", "accentOn": "#FFFFFF", "accent2": "#FF7A59",
        "up": "#12B76A", "down": "#F04438", "warn": "#F59E0B",
        "radius": "16px", "radiusLg": "20px", "shadow": "0 12px 34px rgba(61,90,254,0.10)",
        "fontDisplay": "Space Grotesk", "fontBody": "Inter", "fontMono": "Space Grotesk",
        "density": "22px", "letterSpacing": "0", "uppercase": false
      },
      "icons": ["1.5-stroke geometric SVG (Phosphor/Tabler)"],
      "forbidden": ["dark bg", "neon", "scanlines", "mesh abuse", "gradient-text headlines", "purple-AI palette", "mono as body", "dense cockpit", "emoji", "three-equal glass cards"]
    },
    "spatial": {
      "label": "④ SPATIAL · Strategy Star-map",
      "lineage": "node graphs / React Flow / DAG editors",
      "mode": "dark",
      "bestFor": ["topology", "relationships", "agent/signal graphs"],
      "layoutDNA": "Spatial canvas topology. Dot-grid field. Entities are nodes; SVG-path edges; pulse dots flow along edges. Metrics in semi-transparent floating HUD.",
      "signature": "Pulse dots flowing along edges (direction = capital/signal flow) + breathing active nodes + floating HUD.",
      "structuralNotSkin": true,
      "swiftuiNote": "Best as WebView (React Flow) hybrid; pure-SwiftUI path-following motion needs manual bezier math. See SKILL.md §8.",
      "tokens": {
        "bg": "#070B0C", "panel": "#0F1614", "panel2": "#0F1614",
        "border": "#22403A", "borderWidth": "1px", "hairline": "#22403A",
        "grid": "rgba(120,180,170,0.06)",
        "text": "#CFE0DA", "textDim": "#6C8079", "textMute": "#4A5551",
        "accent": "#5CE6A8", "accentOn": "#04120B", "accent2": "#3FA9E0",
        "up": "#5CE6A8", "down": "#F0645B", "warn": "#E8B84B",
        "radius": "6px", "radiusLg": "8px", "shadow": "none",
        "fontDisplay": "Space Grotesk", "fontBody": "IBM Plex Mono", "fontMono": "IBM Plex Mono",
        "density": "16px", "letterSpacing": "0.02em", "uppercase": false
      },
      "icons": ["circle", "hexagon", "diamond node symbols (SVG)"],
      "glassAllowed": "HUD panels only",
      "forbidden": ["traditional card-grid dashboards", "mesh", "glass abuse (HUD only)", "gradient-text", "purple-AI palette", "emoji"]
    },
    "brutalist": {
      "label": "⑤ BRUTALIST · Feral Degen",
      "lineage": "Blur / Blast / pump.fun",
      "mode": "dark",
      "bestFor": ["alerts", "launch", "memecoin", "high-attention surfaces"],
      "layoutDNA": "Thick-border hard blocks, intentionally offset. Offset hard shadow 6px 6px 0 #000 (solid). radius:0. Big-type marquee. Extreme size contrast.",
      "signature": "Giant compressed-black number + big-type marquee + offset hard-shadow blocks. Hover seats the shadow via translate(3px,3px).",
      "tokens": {
        "bg": "#0A0A0A", "panel": "#141414", "panel2": "#1A1A1A",
        "border": "#E5FF00", "borderWidth": "2px", "hairline": "#2A2A2A",
        "text": "#FFFFFF", "textDim": "#B8B8B8", "textMute": "#777777",
        "accent": "#E5FF00", "accentOn": "#000000",
        "up": "#00E676", "down": "#FF3B3B", "warn": "#E5FF00", "magenta": "#FF2E9A",
        "radius": "0px", "radiusLg": "0px", "shadow": "6px 6px 0 #000",
        "fontDisplay": "Anton", "fontBody": "Space Mono", "fontMono": "Space Mono",
        "density": "18px", "letterSpacing": "0.03em", "uppercase": true
      },
      "icons": ["▲", "▼", "■", "►", "✕"],
      "forbidden": ["soft shadows", "glass", "any radius", "mesh", "gradient-text", "purple-AI palette", "precious micro-interactions", "gentle symmetric centering"]
    },
    "rwa": {
      "label": "⑥ RWA · Institutional Serif",
      "lineage": "Ondo / Ethena / Superstate",
      "mode": "dark",
      "bestFor": ["asset reports", "institutional", "LP-facing surfaces"],
      "layoutDNA": "Dignified report grid. Serif wordmark + fine divider. Large serif numbers, precise small labels (factsheet). Fine-hairline financial tables, right-aligned numbers.",
      "signature": "Large serif number + precise timestamp caption ('as of 2026-07-14') + factsheet-style precision grid. Feels like a printed LP report.",
      "tokens": {
        "bg": "#0B1310", "panel": "#101B16", "panel2": "#0E1712",
        "border": "#22322B", "borderWidth": "1px", "hairline": "#22322B",
        "text": "#E8E4D6", "textDim": "#8A9188", "textMute": "#5F6B62",
        "accent": "#C9A86A", "accentOn": "#0B1310", "green": "#2E7D5B",
        "up": "#3E9B6E", "down": "#B54A45", "warn": "#C9922A",
        "radius": "3px", "radiusLg": "4px", "shadow": "none",
        "fontDisplay": "Cormorant Garamond", "fontBody": "Inter", "fontMono": "IBM Plex Mono",
        "density": "22px", "letterSpacing": "0.02em", "uppercase": false
      },
      "icons": ["thin-stroke geometric SVG (sparingly)"],
      "forbidden": ["neon", "scanlines", "glass", "mesh", "gradient-text", "purple-AI palette", "emoji", "cyber vibes", "flashy motion", "Fraunces", "Instrument Serif"]
    }
  },
  "googleFonts": {
    "ledger": ["IBM+Plex+Mono:wght@400;500;600"],
    "depth": ["JetBrains+Mono:wght@400;500;700"],
    "protocol": ["Space+Grotesk:wght@400;500;600;700", "Inter:wght@400;500;600;700"],
    "spatial": ["Space+Grotesk:wght@400;500;600", "IBM+Plex+Mono:wght@400;500"],
    "brutalist": ["Anton", "Archivo:wght@600;800", "Space+Mono:wght@400;700"],
    "rwa": ["Cormorant+Garamond:wght@500;600;700", "Inter:wght@400;500;600", "IBM+Plex+Mono:wght@400;500"]
