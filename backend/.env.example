# 本机已经能跑的部分不用改。下面每一项都是我无法代替你完成的。
# 复制到 backend/.env 后只填你自己的值。不要把填好的 .env 提交到仓库。

DATABASE_URL=postgresql://pulsedesk:pulsedesk@127.0.0.1:5432/pulsedesk
REDIS_URL=redis://127.0.0.1:6379/0
FREQTRADE_URL=http://127.0.0.1:8080
FREQTRADE_USERNAME=freqtrade
FREQTRADE_PASSWORD=freqtrade
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
LOG_FORMAT=json
LIVE_SMALL_ENABLED=false

# --- 币安 Demo（模拟撮合，不动真钱）---
# 在 https://testnet.binance.vision/ 或币安 Demo Trading 登录后生成。
# 不是主站实盘密钥。权限只开现货交易，不要开提现。
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# --- 币安主站实盘（最后才用）---
# 主站 API 管理里创建。现货交易，禁止提现。开了 IP 白名单要把本机出口 IP 加进去。
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- X / Twitter 历史消息 ---
# https://developer.x.com 创建应用，需要能读历史推文的权限。
# 没有这个密钥，回测读不到 X 消息。
X_BEARER_TOKEN=

# --- 链上 ---
# 三个里至少配一个，回测才能使用巨鲸或链上指标。
# Whale Alert: https://whale-alert.io  请求头或参数里的 api_key
WHALE_ALERT_API_KEY=
# Glassnode: https://glassnode.com  查询参数 api_key
GLASSNODE_API_KEY=
# CryptoQuant: https://cryptoquant.com  请求头 X-API-Token
CRYPTOQUANT_API_KEY=

# --- 社交热度（可选，X 之外的另一路）---
# LunarCrush: https://lunarcrush.com
LUNARCRUSH_API_KEY=
# CryptoPanic: https://cryptopanic.com
CRYPTOPANIC_API_KEY=

# --- 币安 Agent MCP ---
# 不在这里填密钥。要在浏览器里登录 Binance.com，完成 Grok 弹出的 OAuth。
# 服务已登记为 binance-mcp-server，地址 https://agent.binance.com/mcp/agentic

# --- 安全基线（P0，必填）---
# 随机 JWT 签名密钥：python3 -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Provider 凭据加密密钥（Fernet）：python3 -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
# 未设置时后端拒绝写入凭据（fail closed），不会再明文落库。
PULSEDESK_ENCRYPTION_KEY=
# development | production。production 下默认密钥/缺失加密密钥会拒绝启动。
APP_ENV=development
# 设为 false 仅用于本机测试；远程部署必须为 true。
AUTH_REQUIRED=true
# 首个用户自动创建后，是否仍允许公开注册（默认 false）。
ALLOW_PUBLIC_REGISTRATION=false

# --- 远程服务端（Docker/服务器）---
# 本机保持 127.0.0.1；服务器置 0.0.0.0，由 Caddy/Nginx 终止 TLS。
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
# JSON 数组。填实际域名，例如 ["api.example.com","localhost"]；["*"] 仅限可信反代。
ALLOWED_HOSTS=["localhost","127.0.0.1"]
